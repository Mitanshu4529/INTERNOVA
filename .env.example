# Supabase project (Project Settings -> API). The anon key is meant to be public;
# data is protected by Row Level Security policies on the database, not by hiding this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Do NOT add VITE_LLM_API_KEY or any other secret here: every VITE_* value is
# compiled into the public JavaScript bundle.
